# ==============================================================================
# OneVault (share-shield) Environment Configuration Example
# Copy to .env for local development. NEVER commit real secrets to version control.
# ==============================================================================

# Application runtime environment: development | test | production
NODE_ENV=development

# HTTP listener port (1 - 65535)
PORT=3000

# PostgreSQL connection string (placeholder only - replace locally)
DATABASE_URL=postgresql://db_user:replace_with_password@localhost:5432/onevault_dev

# Comma-separated list of exact allowed frontend origins (no wildcards '*' allowed)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Express trust proxy setting:
# - 'false' for direct connection / local development
# - positive integer (e.g. '1') for hop count behind trusted reverse proxy
# - explicit CIDR/subnet (e.g. 'loopback' or '10.0.0.0/8')
# NOTE: 'true' (unrestricted) is forbidden to prevent X-Forwarded-For spoofing.
TRUST_PROXY=false

# Secret salt used for HMAC-SHA256 hashing of client IPs in rate limit buckets (min 16 chars)
IP_HASH_SALT=replace_with_random_32_byte_hex_salt_in_production

# Secret pepper used for HMAC-SHA256 hashing of 6-digit passkeys (min 32 chars)
PASSKEY_PEPPER=replace_with_random_64_char_secret_pepper_in_production

# Maximum wrong passkey attempts before secret is permanently locked (default: 5, range: 3-10)
PASSKEY_MAX_ATTEMPTS=5

# Optional Redis URL for distributed rate limiting across multiple instances
# Leave commented out or empty to use the in-memory store
# REDIS_URL=redis://localhost:6379

# Rate-limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Rate-limit maximum requests per window per client bucket
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_STATUS_MAX=30
RATE_LIMIT_CONSUME_MAX=15
RATE_LIMIT_REVOKE_MAX=15
RATE_LIMIT_AUTH_MAX=10

# Logging verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Request & payload size limits (derived from 10 KiB plaintext maximum)
MAX_BODY_SIZE=16kb
MAX_PLAINTEXT_BYTES=10240
MIN_CIPHERTEXT_CHARS=23
MAX_CIPHERTEXT_CHARS=13675

# Background cleanup worker settings
CLEANUP_INTERVAL_MS=900000
CLEANUP_RETENTION_HOURS=24
