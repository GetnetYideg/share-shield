{
  "name": "share-shield-backend",
  "version": "1.0.0",
  "description": "OneVault (share-shield) — Zero-knowledge one-time secret sharing vault backend API",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "cleanup": "tsx src/jobs/cleanup.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.39.3",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "pg": "8.13.3",
    "pino": "9.6.0",
    "rate-limit-redis": "4.2.0",
    "redis": "4.7.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.13.4",
    "@types/pg": "8.11.11",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "3.0.6",
    "drizzle-kit": "0.30.4",
    "eslint": "9.20.0",
    "eslint-plugin-security": "3.0.1",
    "prettier": "3.5.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vitest": "3.0.6"
  }
}
