# ==============================================================================
# ShareShield Frontend Environment Configuration
# ==============================================================================

# Base URL for the ShareShield backend API (including /api/v1 prefix)
# - Default with Vite dev server proxy: /api/v1
# - Direct backend connection: http://localhost:3000/api/v1
# - Production deployment: /api/v1 (or https://your-domain.com/api/v1)
VITE_API_URL=/api/v1
